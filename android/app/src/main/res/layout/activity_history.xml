<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/history_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/collie_background"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_pane_header"
        android:minHeight="@dimen/collie_header_height">

        <com.lateapex.collie.ui.CollieWideMaxWidthLinearLayout
            android:id="@+id/history_header_normal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center_vertical"
            android:minHeight="@dimen/collie_header_height"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/history_back_button"
                style="@style/Widget.Collie.Header.IconButton"
                android:contentDescription="@string/history_back"
                android:padding="6dp"
                android:src="@drawable/collie_mark" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="6dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_history_transcript"
                        app:tint="@color/collie_muted" />

                    <com.lateapex.collie.ui.CollieHeadingTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="@string/history_title"
                        android:textColor="@color/collie_foreground"
                        android:textSize="16sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/history_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/collie_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/history_find_open"
                style="@style/Widget.Collie.Header.IconButton"
                android:layout_width="@dimen/collie_touch_target"
                android:layout_height="@dimen/collie_touch_target"
                android:contentDescription="@string/history_find_open"
                android:padding="10dp"
                android:src="@drawable/ic_history_search" />

            <TextView
                android:id="@+id/history_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="4dp"
                android:includeFontPadding="false"
                android:textColor="@color/collie_muted"
                android:textSize="12sp" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/history_close"
                style="@style/Widget.Collie.Header.IconButton"
                android:layout_width="@dimen/collie_touch_target"
                android:layout_height="@dimen/collie_touch_target"
                android:contentDescription="@string/history_close"
                android:padding="10dp"
                android:src="@drawable/ic_collie_close" />
        </com.lateapex.collie.ui.CollieWideMaxWidthLinearLayout>

        <com.lateapex.collie.ui.CollieWideMaxWidthLinearLayout
            android:id="@+id/history_header_find"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center_vertical"
            android:minHeight="@dimen/collie_header_height"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_history_search"
                app:tint="@color/collie_muted" />

            <EditText
                android:id="@+id/history_find_query"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:autofillHints=""
                android:background="@drawable/bg_collie_input"
                android:hint="@string/history_find_hint"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:paddingHorizontal="8dp"
                android:textColor="@color/collie_foreground"
                android:textColorHint="@color/collie_muted"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/history_find_count"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:gravity="center"
                android:minWidth="38dp"
                android:textColor="@color/collie_muted"
                android:textSize="12sp" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/history_find_previous"
                style="@style/Widget.Collie.Header.IconButton"
                android:layout_width="@dimen/collie_touch_target"
                android:layout_height="@dimen/collie_touch_target"
                android:contentDescription="@string/history_find_previous"
                android:padding="10dp"
                android:src="@drawable/ic_history_chevron_up" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/history_find_next"
                style="@style/Widget.Collie.Header.IconButton"
                android:layout_width="@dimen/collie_touch_target"
                android:layout_height="@dimen/collie_touch_target"
                android:contentDescription="@string/history_find_next"
                android:padding="10dp"
                android:src="@drawable/ic_history_chevron_down" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/history_find_close"
                style="@style/Widget.Collie.Header.IconButton"
                android:layout_width="@dimen/collie_touch_target"
                android:layout_height="@dimen/collie_touch_target"
                android:contentDescription="@string/history_find_close"
                android:padding="10dp"
                android:src="@drawable/ic_collie_close" />
        </com.lateapex.collie.ui.CollieWideMaxWidthLinearLayout>
    </FrameLayout>

    <com.lateapex.collie.ui.HistoryMaxWidthFrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="center_horizontal"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/history_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="ifContentScrolls">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingVertical="12dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/history_load_older"
                    style="@style/Widget.Collie.Button.Borderless"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:drawableStart="@drawable/ic_history_load_older"
                    android:drawablePadding="6dp"
                    android:text="@string/history_load_older"
                    android:textColor="@color/collie_muted"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/history_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="16dp"
                    android:textColor="@color/collie_muted"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/history_entries"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>

        <ProgressBar
            android:id="@+id/history_progress"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center" />

        <LinearLayout
            android:id="@+id/history_user_jumps"
            android:layout_width="@dimen/collie_touch_target"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="12dp"
            android:background="@drawable/bg_history_jump_group"
            android:elevation="4dp"
            android:orientation="vertical"
            android:visibility="gone">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/history_previous_user"
                android:layout_width="@dimen/collie_touch_target"
                android:layout_height="@dimen/collie_touch_target"
                android:background="@drawable/bg_collie_icon_control"
                android:contentDescription="@string/history_previous_user"
                android:padding="10dp"
                android:src="@drawable/ic_history_chevron_up"
                app:tint="@color/collie_muted" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/collie_border" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/history_next_user"
                android:layout_width="@dimen/collie_touch_target"
                android:layout_height="@dimen/collie_touch_target"
                android:background="@drawable/bg_collie_icon_control"
                android:contentDescription="@string/history_next_user"
                android:padding="10dp"
                android:src="@drawable/ic_history_chevron_down"
                app:tint="@color/collie_muted" />
        </LinearLayout>
    </com.lateapex.collie.ui.HistoryMaxWidthFrameLayout>
</LinearLayout>
