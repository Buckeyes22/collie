<?xml version="1.0" encoding="utf-8"?>
<com.lateapex.collie.ui.CollieMaxWidthLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/collie_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/collie_header_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <ImageButton
            android:id="@+id/changes_back"
            android:layout_width="@dimen/collie_touch_target"
            android:layout_height="@dimen/collie_touch_target"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/navigate_back"
            android:padding="2dp"
            android:src="@drawable/ic_collie_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/changes_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/changes_title"
                android:textColor="@color/collie_on_background"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/changes_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/collie_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/changes_refresh"
            android:layout_width="@dimen/collie_touch_target"
            android:layout_height="@dimen/collie_touch_target"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/changes_refresh"
            android:padding="10dp"
            android:src="@drawable/ic_dashboard_reload" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/collie_rule" />

    <ProgressBar
        android:id="@+id/changes_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="true"
        android:visibility="gone" />

    <TextView
        android:id="@+id/changes_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:textColor="@color/collie_error"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/changes_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <LinearLayout
            android:id="@+id/changes_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="24dp" />
    </ScrollView>
</com.lateapex.collie.ui.CollieMaxWidthLinearLayout>
