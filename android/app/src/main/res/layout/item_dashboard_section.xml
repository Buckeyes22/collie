<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="20dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/collie_touch_target"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageButton
            android:id="@+id/section_toggle"
            android:layout_width="@dimen/collie_touch_target"
            android:layout_height="@dimen/collie_touch_target"
            android:background="@drawable/bg_collie_icon_control"
            android:padding="11dp"
            android:src="@drawable/ic_collie_back"
            android:visibility="gone" />
        <View
            android:id="@+id/section_dot"
            android:layout_width="8dp"
            android:layout_height="8dp" />
        <com.lateapex.collie.ui.CollieHeadingTextView
            android:id="@+id/section_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:letterSpacing="0.025"
            android:textColor="@color/collie_muted"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/section_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:textColor="@color/collie_muted"
            android:textSize="12sp" />
        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />
        <Button
            android:id="@+id/section_sort"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/collie_touch_target"
            android:background="@drawable/bg_collie_icon_control"
            android:minWidth="88dp"
            android:text="@string/recent_sort"
            android:textAllCaps="false"
            android:textColor="@color/collie_muted"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/section_rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
</LinearLayout>
