<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/collie_sheet_panel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_collie_sheet"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/collie_card"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="12dp">

            <View
                android:layout_width="@dimen/collie_sheet_grip_width"
                android:layout_height="@dimen/collie_sheet_grip_height"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_collie_sheet_grip"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/collie_page_gutter"
            android:paddingEnd="6dp">

            <TextView
                android:id="@+id/collie_sheet_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Collie.Chrome"
                android:textSize="14sp" />

            <ImageButton
                android:id="@+id/collie_sheet_close"
                style="@style/Widget.Collie.Header.IconButton"
                android:layout_width="@dimen/collie_touch_target"
                android:layout_height="@dimen/collie_touch_target"
                android:contentDescription="@string/tab_action_close"
                android:padding="8dp"
                android:src="@drawable/ic_collie_close" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/collie_stroke"
            android:background="@color/collie_rule" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="false"
        android:overScrollMode="ifContentScrolls">

        <FrameLayout
            android:id="@+id/collie_sheet_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/collie_page_gutter"
            android:paddingTop="12dp"
            android:paddingEnd="@dimen/collie_page_gutter"
            android:paddingBottom="16dp" />
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
