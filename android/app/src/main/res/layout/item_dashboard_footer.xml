<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:id="@+id/dashboard_pack_link"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:contentDescription="@string/pack_footer_accessibility"
        android:focusable="true"
        android:gravity="center"
        android:minHeight="44dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_pack_network" />

        <TextView
            android:id="@+id/dashboard_pack_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="6dp"
            android:textColor="@color/collie_muted"
            android:textSize="11sp" />

        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_history_chevron_right" />
    </LinearLayout>

    <TextView
        android:id="@+id/dashboard_footer_update_notice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dashboard_shell_working"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:minHeight="44dp"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp"
        android:textColor="@color/collie_working"
        android:textSize="11sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/build_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="8dp"
        android:textColor="@color/collie_muted"
        android:textSize="11sp" />
</LinearLayout>
