<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.Collie.PaneKey" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_height">@dimen/collie_touch_target</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">@dimen/collie_touch_target</item>
        <item name="minHeight">@dimen/collie_touch_target</item>
        <item name="android:paddingLeft">6dp</item>
        <item name="android:paddingRight">6dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/collie_foreground</item>
        <item name="android:textSize">11sp</item>
        <item name="backgroundTint">@color/collie_chrome</item>
        <item name="cornerRadius">@dimen/collie_corner_radius</item>
        <item name="strokeColor">@color/collie_border</item>
        <item name="strokeWidth">@dimen/collie_stroke</item>
    </style>

    <style name="Widget.Collie.PaneMode" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_height">@dimen/collie_touch_target</item>
        <item name="android:fontFamily">@font/collie_ui</item>
        <item name="android:drawablePadding">2dp</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">@dimen/collie_touch_target</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/collie_muted</item>
        <item name="android:textSize">10sp</item>
        <item name="android:background">@drawable/bg_collie_icon_control</item>
    </style>
</resources>
